  bankName          String?   @map("bank_name") @db.VarChar(100)
  bankAccountNumber String?   @map("bank_account_number") @db.VarChar(50)
  bankAccountName   String?   @map("bank_account_name") @db.VarChar(150)
  paymentNote       String?   @map("payment_note") @db.VarChar(255)
  receiptUrl        String?   @map("receipt_url")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  paidById          String?   @map("paid_by_id") @db.Uuid
  paidByName        String?   @map("paid_by_name") @db.VarChar(150)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  coach             User      @relation("CoachPayouts", fields: [coachId], references: [id], onDelete: Cascade)
  paidBy            User?     @relation("PaidPayouts", fields: [paidById], references: [id], onUpdate: NoAction)

  @@unique([coachId, month], map: "uq_coach_payouts_coach_month")
  @@index([month], map: "idx_coach_payouts_month")
  @@index([coachId], map: "idx_coach_payouts_coach_id")
  @@map("coach_payouts")
}

model CoachTopicRequest {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coachId         String    @map("coach_id") @db.Uuid
  specialtyId     String    @map("specialty_id") @db.Uuid
  reason          String    @db.VarChar(500)
  certificateUrl  String?   @map("certificate_url") @db.VarChar(500)
  status          String    @default("PENDING") @db.VarChar(50)
  reviewedById    String?   @map("reviewed_by_id") @db.Uuid
  reviewedAt      DateTime? @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason String?   @map("rejection_reason") @db.VarChar(500)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  coach           User      @relation("CoachTopicRequests", fields: [coachId], references: [id], onDelete: Cascade)
  specialty       Specialty @relation(fields: [specialtyId], references: [id], onDelete: Cascade)
  reviewedBy      User?     @relation("ReviewedTopicRequests", fields: [reviewedById], references: [id], onUpdate: NoAction)

  @@index([coachId], map: "idx_coach_topic_requests_coach_id")
  @@index([status], map: "idx_coach_topic_requests_status")
  @@map("coach_topic_requests")
}

model PeakHourConfig {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label       String   @db.VarChar(120)
  startHour   Int      @map("start_hour")
  startMinute Int      @default(0) @map("start_minute")
  endHour     Int      @map("end_hour")
  endMinute   Int      @default(0) @map("end_minute")
  dailyCap    Int      @default(2) @map("daily_cap")
  weeklyCap   Int      @default(10) @map("weekly_cap")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("peak_hour_configs")
}

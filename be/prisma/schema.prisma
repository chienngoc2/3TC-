generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model User {
  id                                                                     String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                                  String                @unique(map: "uq_users_email") @db.VarChar(255)
  passwordHash                                                           String                @map("password_hash") @db.VarChar(255)
  fullName                                                               String                @map("full_name") @db.VarChar(150)
  phone                                                                  String                @unique(map: "uq_users_phone") @db.VarChar(20)
  role                                                                   UserRole              @default(MEMBER)
  gender                                                                 UserGender            @default(OTHER) @map("gender")
  avatarUrl                                                              String?               @map("avatar_url")
  checkinCode                                                            String?               @default("1234") @map("checkin_code") @db.VarChar(10)
  isActive                                                               Boolean               @default(true) @map("is_active")
  tokenVersion                                                           Int                   @default(1) @map("token_version")
  createdById                                                            String?               @map("created_by_id") @db.Uuid
  createdAt                                                              DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                              DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  created_by_name                                                        String?               @db.VarChar(150)
  attendances                                                            Attendance[]          @relation("MemberAttendances")
  verifiedAttendances                                                    Attendance[]          @relation("VerifiedByStaff")
  auditLogs                                                              AuditLog[]
  bookings                                                               Booking[]             @relation("MemberBookings")
  coachCancellationRequests                                              CancellationRequest[] @relation("CoachCancellationRequests")
  reviewedCancellationRequests                                           CancellationRequest[] @relation("ReviewedCancellationRequests")
  substituteCancellationRequests                                         CancellationRequest[] @relation("SubstituteCoachRequests")
  checkoutOrders                                                         CheckoutOrder[]
  coachAvailabilities                                                    CoachAvailability[]
  coachPenalties                                                         CoachPenalty[]        @relation("CoachPenalties")
  coachProfile                                                           CoachProfile?
  coachRates                                                             CoachRate[]
  issuedInvoices                                                         Invoice[]             @relation("InvoiceIssuer")
  assignedLockers                                                        LockerAssignment[]    @relation("StaffLockerAssignments")
  lockerAssignments                                                      LockerAssignment[]    @relation("MemberLockerAssignments")
  measuredInbodyLogs                                                     MemberInbodyLog[]     @relation("MeasuredByStaff")
  memberInbodyLogs                                                       MemberInbodyLog[]     @relation("MemberInbodyLogs")
  memberProfile                                                          MemberProfile?
  coachedSchedules                                                       Schedule[]            @relation("CoachSchedules")
  assignedStaffShifts                                                    StaffShift[]          @relation("AssignedShifts")
  staffShifts                                                            StaffShift[]          @relation("StaffShifts")
  sessions                                                               UserSession[]
  assignedVipSubs                                                        UserSubscription[]    @relation("AssignedCoachSubs")
  subscriptions                                                          UserSubscription[]    @relation("UserSubscriptions")
  createdBy                                                              User?                 @relation("UserCreator", fields: [createdById], references: [id], map: "fk_users_created_by")
  createdUsers                                                           User[]                @relation("UserCreator")
  coachWorkoutPlans                                                      WorkoutPlan[]         @relation("CoachWorkoutPlans")
  memberWorkoutPlans                                                     WorkoutPlan[]         @relation("MemberWorkoutPlans")
  approvedCoachSlots                                                     CoachAvailability[]   @relation("ApprovedCoachSlots")
  coachPayouts                                                           CoachPayout[]         @relation("CoachPayouts")
  paidPayouts                                                            CoachPayout[]         @relation("PaidPayouts")
  coachTopicRequests                                                     CoachTopicRequest[]   @relation("CoachTopicRequests")
  reviewedTopicRequests                                                  CoachTopicRequest[]   @relation("ReviewedTopicRequests")

  @@index([createdById], map: "idx_users_created_by_id")
  @@map("users")
}

model UserSession {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.VarChar(255)
  deviceInfo       String?  @map("device_info") @db.VarChar(255)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user_name        String?  @db.VarChar(150)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_user_sessions_user")

  @@index([userId], map: "idx_user_sessions_user_id")
  @@map("user_sessions")
}

model MemberProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique(map: "uq_member_profiles_user_id") @map("user_id") @db.Uuid
  heightCm       Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg       Decimal? @map("weight_kg") @db.Decimal(5, 2)
  bmi            Decimal? @map("bmi") @db.Decimal(4, 2)
  bodyFatPct     Decimal? @map("body_fat_pct") @db.Decimal(4, 2)
  fitnessGoals   String?  @map("fitness_goals")
  medicalHistory String?  @map("medical_history")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user_name      String?  @db.VarChar(150)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_member_profiles_user")

  @@map("member_profiles")
}

model CoachProfile {
  id                            String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                        String           @unique(map: "uq_coach_profiles_user_id") @map("user_id") @db.Uuid
  specialties                   String?
  bio                           String?
  certificateUrls               String[]         @default([]) @map("certificate_urls")
  yearsExperience               Int?             @default(0) @map("years_experience")
  emergencyCancellationCount    Int              @default(0) @map("emergency_cancellation_count")
  monthlyEmergencyCancellations Int              @default(0) @map("monthly_emergency_cancellations")
  lastCancellationResetDate     DateTime?        @map("last_cancellation_reset_date") @db.Date
  bankName                      String?          @map("bank_name") @db.VarChar(100)
  bankAccountNumber             String?          @map("bank_account_number") @db.VarChar(50)
  bankAccountName               String?          @map("bank_account_name") @db.VarChar(150)
  workingDays                   Json?            @default("[]") @map("working_days")
  workingHours                  Json?            @default("[]") @map("working_hours")
  ratingStars                   Int              @default(3) @map("rating_stars")
  ratePerSession                Decimal          @default(300000) @map("rate_per_session") @db.Decimal(12, 2)
  updatedAt                     DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  user_name                     String?          @db.VarChar(150)
  user                          User             @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_coach_profiles_user")
  coachSpecialties              CoachSpecialty[]

  @@index([ratingStars], map: "idx_coach_profiles_rating_stars")
  @@map("coach_profiles")
}

model CoachRate {
  id             String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coachId        String                    @map("coach_id") @db.Uuid
  disciplineId   String?                   @map("discipline_id") @db.Uuid
  ratePerSession Decimal                   @map("rate_per_session") @db.Decimal(12, 2)
  effectiveFrom  DateTime                  @default(now()) @map("effective_from") @db.Date
  effectiveTo    DateTime?                 @map("effective_to") @db.Date
  createdAt      DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  rate_range     Unsupported("daterange")? @default(dbgenerated("daterange(effective_from, effective_to, '[]'::text)"))
  coach_name     String?                   @db.VarChar(150)
  coach          User                      @relation(fields: [coachId], references: [id], onDelete: Cascade, map: "fk_coach_rates_coach")
  discipline     Discipline?               @relation(fields: [disciplineId], references: [id], onDelete: Restrict, map: "fk_coach_rates_discipline")

  @@index([coachId], map: "idx_coach_rates_coach_id")
  @@index([coachId, disciplineId], map: "idx_coach_rates_coach_discipline")
  @@map("coach_rates")
}

model StaffShift {
  id               String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId          String                    @map("staff_id") @db.Uuid
  shiftDate        DateTime                  @map("shift_date") @db.Date
  startTime        DateTime                  @map("start_time") @db.Timestamptz(6)
  endTime          DateTime                  @map("end_time") @db.Timestamptz(6)
  assignedById     String?                   @map("assigned_by_id") @db.Uuid
  notes            String?
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  shift_range      Unsupported("tstzrange")? @default(dbgenerated("tstzrange(start_time, end_time, '[)'::text)"))
  staff_name       String?                   @db.VarChar(150)
  assigned_by_name String?                   @db.VarChar(150)
  assignedBy       User?                     @relation("AssignedShifts", fields: [assignedById], references: [id], map: "fk_staff_shifts_assigned_by")
  staff            User                      @relation("StaffShifts", fields: [staffId], references: [id], onDelete: Cascade, map: "fk_staff_shifts_staff")

  @@index([staffId], map: "idx_staff_shifts_staff_id")
  @@index([shiftDate], map: "idx_staff_shifts_shift_date")
  @@map("staff_shifts")
}

model Discipline {
  id                     String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                   String                      @unique(map: "uq_disciplines_code") @db.VarChar(50)
  name                   String                      @unique(map: "uq_disciplines_name") @db.VarChar(100)
  description            String?
  bookings               Booking[]
  classes                Class[]
  coachRates             CoachRate[]
  plans                  MembershipPlan[]
  curriculumRequirements PlanCurriculumRequirement[]
  specialties            Specialty[]
  userSubscriptions      UserSubscription[]
  rooms                  Room[]

  @@map("disciplines")
}

model Specialty {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId     String           @map("discipline_id") @db.Uuid
  code             String           @unique(map: "uq_specialties_code") @db.VarChar(50)
  name             String           @db.VarChar(150)
  description      String?
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  coachSpecialties   CoachSpecialty[]
  coachTopicRequests CoachTopicRequest[]
  discipline         Discipline       @relation(fields: [disciplineId], references: [id], map: "fk_specialties_discipline")

  @@index([disciplineId], map: "idx_specialties_discipline_id")
  @@map("specialties")
}

model CoachSpecialty {
  coachProfileId String       @map("coach_profile_id") @db.Uuid
  specialtyId    String       @map("specialty_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  coachProfile   CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade, map: "fk_coach_spec_profile")
  specialty      Specialty    @relation(fields: [specialtyId], references: [id], map: "fk_coach_spec_specialty")

  @@id([coachProfileId, specialtyId])
  @@index([specialtyId], map: "idx_coach_specialties_spec_id")
  @@map("coach_specialties")
}

model MembershipPlan {
  id                      String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId            String?                     @map("discipline_id") @db.Uuid
  name                    String                      @db.VarChar(100)
  description             String?
  price                   Decimal                     @db.Decimal(12, 2)
  durationDays            Int                         @map("duration_days")
  sessionQuota            Int?                        @map("session_quota")
  planType                PlanType                    @default(GENERAL) @map("plan_type")
  isActive                Boolean                     @default(true) @map("is_active")
  createdAt               DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  packageTier             PackageTier                 @default(PLUS) @map("package_tier")
  packageCategory         String?                     @map("package_category") @db.VarChar(50)
  trainingMode            TrainingMode                @default(GROUP_CLASS) @map("training_mode")
  groupSessionQuota       Int?                        @default(0) @map("group_session_quota")
  ptSessionQuota          Int?                        @default(0) @map("pt_session_quota")
  unlimitedGymEntry       Boolean?                    @default(false) @map("unlimited_gym_entry")
  curriculumTopics        Json?                       @map("curriculum_topics")
  weeklySchedulePreview   Json?                       @map("weekly_schedule_preview")
  recommendedRoadmap      Json?                       @map("recommended_roadmap")
  twoSportRule            String?                     @map("two_sport_rule")
  coachRatingStars        Int?                        @default(3) @map("coach_rating_stars")
  roomId                  String?                     @map("room_id") @db.Uuid
  discipline              Discipline?                 @relation(fields: [disciplineId], references: [id], onDelete: Restrict, map: "fk_plans_discipline")
  room                    Room?                       @relation(fields: [roomId], references: [id], onDelete: SetNull, map: "fk_plans_room")
  curriculumRequirements  PlanCurriculumRequirement[]
  subscriptions           UserSubscription[]

  @@index([roomId], map: "idx_plans_room_id")
  @@map("membership_plans")
}

model PlanCurriculumRequirement {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String         @map("plan_id") @db.Uuid
  disciplineId    String         @map("discipline_id") @db.Uuid
  sessionsPerWeek Int            @map("sessions_per_week")
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  discipline      Discipline     @relation(fields: [disciplineId], references: [id], map: "fk_curriculum_discipline")
  plan            MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade, map: "fk_curriculum_plan")

  @@unique([planId, disciplineId], map: "uq_curriculum_plan_discipline")
  @@index([planId], map: "idx_curriculum_plan_id")
  @@map("plan_curriculum_requirements")
}

model UserSubscription {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String             @map("user_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  disciplineId           String?            @map("discipline_id") @db.Uuid
  packageTier            PackageTier        @default(PLUS) @map("package_tier")
  packageCategory        String?            @map("package_category") @db.VarChar(50)
  coachRatingStars       Int?               @default(3) @map("coach_rating_stars")
  assignedCoachId        String?            @map("assigned_coach_id") @db.Uuid
  startDate              DateTime           @map("start_date") @db.Date
  endDate                DateTime           @map("end_date") @db.Date
  remainingSessions      Int?               @map("remaining_sessions")
  remainingGroupSessions Int?               @default(0) @map("remaining_group_sessions")
  remainingPtSessions    Int?               @default(0) @map("remaining_pt_sessions")
  hasUnlimitedGymAccess  Boolean?           @default(false) @map("has_unlimited_gym_access")
  status                 SubscriptionStatus @default(ACTIVE)
  frozenAt               DateTime?          @map("frozen_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  member_name            String?            @db.VarChar(150)
  assigned_coach_name    String?            @db.VarChar(150)
  bookings               Booking[]
  invoices               Invoice[]
  assignedCoach          User?              @relation("AssignedCoachSubs", fields: [assignedCoachId], references: [id], map: "fk_user_subscriptions_coach")
  discipline             Discipline?        @relation(fields: [disciplineId], references: [id], onDelete: Restrict, map: "fk_user_subscriptions_discipline")
  plan                   MembershipPlan     @relation(fields: [planId], references: [id], map: "fk_user_subscriptions_plan")
  user                   User               @relation("UserSubscriptions", fields: [userId], references: [id], map: "fk_user_subscriptions_user")

  @@index([userId], map: "idx_user_subscriptions_user_id")
  @@index([planId], map: "idx_user_subscriptions_plan_id")
  @@index([assignedCoachId], map: "idx_user_subscriptions_coach_id")
  @@map("user_subscriptions")
}

model Invoice {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceCode    String           @unique(map: "uq_invoices_invoice_code") @map("invoice_code") @db.VarChar(50)
  subscriptionId String           @map("subscription_id") @db.Uuid
  issuerId       String           @map("issuer_id") @db.Uuid
  amount         Decimal          @db.Decimal(12, 2)
  baseAmount     Decimal?         @default(0) @map("base_amount") @db.Decimal(12, 2)
  ptAmount       Decimal?         @default(0) @map("pt_amount") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod    @map("payment_method")
  status         InvoiceStatus    @default(PAID)
  type           InvoiceType      @default(SUBSCRIPTION_NEW)
  transactionRef String?          @map("transaction_ref") @db.VarChar(100)
  checkoutId     String?          @unique(map: "uq_invoices_checkout_id") @map("checkout_id") @db.Uuid
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  issuer_name    String?          @db.VarChar(150)
  issuer         User             @relation("InvoiceIssuer", fields: [issuerId], references: [id], map: "fk_invoices_issuer")
  subscription   UserSubscription @relation(fields: [subscriptionId], references: [id], map: "fk_invoices_subscription")
  checkout       CheckoutOrder?   @relation(fields: [checkoutId], references: [id], onDelete: Restrict)

  @@index([subscriptionId], map: "idx_invoices_subscription_id")
  @@index([issuerId], map: "idx_invoices_issuer_id")
  @@index([createdAt], map: "idx_invoices_created_at")
  @@map("invoices")
}

model CheckoutOrder {
  id                      String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId                String                @map("member_id") @db.Uuid
  kind                    CheckoutKind
  status                  CheckoutStatus        @default(PENDING_PAYMENT)
  planId                  String?               @map("plan_id") @db.Uuid
  targetSubscriptionId    String?               @map("target_subscription_id") @db.Uuid
  coachId                 String?               @map("coach_id") @db.Uuid
  addonSessions           Int?                  @map("addon_sessions")
  baseAmount              Decimal               @map("base_amount") @db.Decimal(12, 2)
  ptAmount                Decimal               @map("pt_amount") @db.Decimal(12, 2)
  amount                  Decimal               @db.Decimal(12, 2)
  currency                String                @default("VND") @db.VarChar(3)
  priceSnapshot           Json                  @map("price_snapshot")
  idempotencyKey          String                @map("idempotency_key") @db.VarChar(100)
  requestHash             String                @map("request_hash") @db.VarChar(64)
  expiresAt               DateTime              @map("expires_at") @db.Timestamptz(6)
  failureReason           String?               @map("failure_reason") @db.VarChar(200)
  fulfilledSubscriptionId String?               @map("fulfilled_subscription_id") @db.Uuid
  createdAt               DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  member_name             String?               @db.VarChar(150)
  member                  User                  @relation(fields: [memberId], references: [id])
  invoice                 Invoice?
  attempts                PaymentAttempt[]
  webhookEvents           PaymentWebhookEvent[]

  @@unique([memberId, idempotencyKey], map: "uq_checkout_member_idempotency")
  @@index([memberId, createdAt], map: "idx_checkout_member_created")
  @@index([status, expiresAt], map: "idx_checkout_status_expiry")
  @@map("checkout_orders")
}

model PaymentAttempt {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutId        String               @map("checkout_id") @db.Uuid
  paymentId         String               @unique(map: "uq_payment_attempt_payment_id") @map("payment_id") @db.VarChar(32)
  retryKey          String?              @map("retry_key") @db.VarChar(100)
  status            PaymentAttemptStatus @default(PENDING)
  simulationOutcome String?              @map("simulation_outcome") @db.VarChar(16)
  simulationEventId String?              @unique(map: "uq_payment_attempt_simulation_event") @map("simulation_event_id") @db.Uuid
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  checkout          CheckoutOrder        @relation(fields: [checkoutId], references: [id])

  @@unique([checkoutId, retryKey], map: "uq_payment_attempt_retry_key")
  @@index([checkoutId, createdAt], map: "idx_payment_attempt_checkout_created")
  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkoutId  String        @map("checkout_id") @db.Uuid
  provider    String        @db.VarChar(40)
  eventId     String        @map("event_id") @db.VarChar(100)
  payloadHash String        @map("payload_hash") @db.VarChar(64)
  outcome     String        @db.VarChar(16)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  checkout    CheckoutOrder @relation(fields: [checkoutId], references: [id])

  @@unique([provider, eventId], map: "uq_payment_webhook_event")
  @@index([checkoutId], map: "idx_payment_webhook_checkout")
  @@map("payment_webhook_events")
}

model Room {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId String?          @map("discipline_id") @db.Uuid
  name         String           @db.VarChar(100)
  capacity     Int
  locationNote String?          @map("location_note")
  isActive     Boolean          @default(true) @map("is_active")
  discipline   Discipline?      @relation(fields: [disciplineId], references: [id], onDelete: SetNull, map: "fk_rooms_discipline")
  equipment    Equipment[]
  schedules    Schedule[]
  plans        MembershipPlan[]

  @@index([disciplineId], map: "idx_rooms_discipline_id")
  @@map("rooms")
}

model Equipment {
  id            String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId        String                 @map("room_id") @db.Uuid
  name          String                 @db.VarChar(150)
  equipmentType String                 @map("equipment_type") @db.VarChar(50)
  isActive      Boolean                @default(true) @map("is_active")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  room          Room                   @relation(fields: [roomId], references: [id], map: "fk_equipment_room")
  reservations  EquipmentReservation[]

  @@index([roomId], map: "idx_equipment_room_id")
  @@map("equipment")
}

model Class {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId String     @map("discipline_id") @db.Uuid
  name         String     @db.VarChar(150)
  description  String?
  discipline   Discipline @relation(fields: [disciplineId], references: [id], map: "fk_classes_discipline")
  schedules    Schedule[]

  @@index([disciplineId], map: "idx_classes_discipline_id")
  @@map("classes")
}

model Schedule {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId              String                    @map("class_id") @db.Uuid
  roomId               String                    @map("room_id") @db.Uuid
  coachId              String                    @map("coach_id") @db.Uuid
  startTime            DateTime                  @map("start_time") @db.Timestamptz(6)
  endTime              DateTime                  @map("end_time") @db.Timestamptz(6)
  capacity             Int
  currentEnrolled      Int                       @default(0) @map("current_enrolled")
  status               ScheduleStatus            @default(OPEN)
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  time_range           Unsupported("tstzrange")? @default(dbgenerated("tstzrange(start_time, end_time, '[)'::text)"))
  coach_name           String?                   @db.VarChar(150)
  bookings             Booking[]
  cancellationRequests CancellationRequest[]

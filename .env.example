# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGINS="http://localhost:3001"
# Payment Configuration (PayOS)
MOCK_PAYMENT_ENABLED=false
MOCK_WEBHOOK_SECRET=
PAYOS_CLIENT_ID="52993569-18b6-4f5d-a09b-66ea4e9b3b47"
PAYOS_API_KEY="a29d04f5-6f51-4118-81eb-19f41cfb017e"
PAYOS_CHECKSUM_KEY="ff582abfc2ffcbded24408ddf2a42eae045868938187020fe744703c2656cbec"
PAYOS_RETURN_URL="https://3tcfitness.ddns.net/portal/member/checkout"
PAYOS_CANCEL_URL="https://3tcfitness.ddns.net/portal/member/checkout"

# Supabase Database (Lưu ý: DATABASE_URL kết nối Pooler cổng 6543, DIRECT_URL kết nối cổng 5432)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secrets & Expiration
JWT_ACCESS_SECRET="super_secret_access_key_change_me_in_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="super_secret_refresh_key_change_me_in_production"
JWT_REFRESH_EXPIRES_IN="7d"

# AI Provider Configuration
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional integration tests: isolated schemas only
# TEST_DATABASE_URL="postgresql://...direct-or-session-connection..."

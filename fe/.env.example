# Backend origin only; do not add /docs or /api/v1.
# Dev proxies HTTP and Socket.IO to this origin. Production connects directly.
VITE_API_BASE_URL=https://be-sports-center-management-system.onrender.com
# To use a local backend instead: VITE_API_BASE_URL=http://localhost:3000
# Public URL of the forwarded web port for the QR demo, e.g. https://your-tunnel.example.com
VITE_PUBLIC_WEB_URL=
# Enable only in a demo build. Vite dev mode shows the page automatically.
VITE_ENABLE_MOCK_PAYMENT=false

model CancellationRequest {
  id                   String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coachId              String                    @map("coach_id") @db.Uuid
  targetType           CancellationTargetType    @map("target_type")
  bookingId            String?                   @map("booking_id") @db.Uuid
  scheduleId           String?                   @map("schedule_id") @db.Uuid
  reasonMessage        String                    @map("reason_message") @db.Text
  internalNote         String?                   @map("internal_note") @db.Text
  status               CancellationRequestStatus @default(PENDING)
  reviewedById         String?                   @map("reviewed_by_id") @db.Uuid
  reviewedAt           DateTime?                 @map("reviewed_at") @db.Timestamptz(6)
  rejectionReason      String?                   @map("rejection_reason") @db.Text
  isFrontdeskOverride  Boolean                   @default(false) @map("is_frontdesk_override")
  createdAt            DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)

  coach          User            @relation("CoachCancellationRequests", fields: [coachId], references: [id], onDelete: Cascade, map: "fk_cancellation_requests_coach")
  booking        Booking?        @relation(fields: [bookingId], references: [id], onDelete: Restrict, map: "fk_cancellation_requests_booking")
  schedule       Schedule?       @relation(fields: [scheduleId], references: [id], onDelete: Restrict, map: "fk_cancellation_requests_schedule")
  reviewedBy     User?           @relation("ReviewedCancellationRequests", fields: [reviewedById], references: [id], onDelete: SetNull, map: "fk_cancellation_requests_reviewer")
  coachPenalties CoachPenalty[]

  @@index([status], map: "idx_cancellation_requests_status")
  @@index([coachId], map: "idx_cancellation_requests_coach")
  @@map("cancellation_requests")
}

model CoachPenalty {
  id                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coachId                    String    @map("coach_id") @db.Uuid
  cancellationRequestId      String?   @map("cancellation_request_id") @db.Uuid
  bookingId                  String?   @map("booking_id") @db.Uuid
  penaltyType                String    @default("EMERGENCY_CANCELLATION") @map("penalty_type") @db.VarChar(50)
  appliedMonth               String    @map("applied_month") @db.VarChar(7)
  suggestedAction            String    @default("WARNING") @map("suggested_action") @db.VarChar(50)
  suggestedRateReductionPct  Decimal?  @default(0) @map("suggested_rate_reduction_pct") @db.Decimal(5, 2)
  isReviewedByManager        Boolean   @default(false) @map("is_reviewed_by_manager")
  managerFinalDecision       String?   @map("manager_final_decision") @db.Text
  reviewedAt                 DateTime? @map("reviewed_at") @db.Timestamptz(6)
  notes                      String?   @db.Text
  createdAt                  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  coach               User                 @relation("CoachPenalties", fields: [coachId], references: [id], onDelete: Cascade, map: "fk_coach_penalties_coach")
  cancellationRequest CancellationRequest? @relation(fields: [cancellationRequestId], references: [id], onDelete: SetNull, map: "fk_coach_penalties_cancellation")
  booking             Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull, map: "fk_coach_penalties_booking")

  @@index([coachId, appliedMonth], map: "idx_coach_penalties_month")
  @@index([isReviewedByManager], map: "idx_coach_penalties_pending_review")
  @@map("coach_penalties")
}

model WorkoutPlan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

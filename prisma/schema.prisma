datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -------------------------------------------------------------
// ENUMS (15 Enums - Aligned 100% with SQL_v5.md)
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  CENTER_MANAGER
  COACH
  RECEPTIONIST
  MEMBER

  @@map("user_role")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  FROZEN

  @@map("subscription_status")
}

enum BookingType {
  GROUP_CLASS
  PERSONAL_TRAINING

  @@map("booking_type")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED

  @@map("booking_status")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE

  @@map("attendance_status")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD

  @@map("payment_method")
}

enum InvoiceStatus {
  PAID
  PENDING
  REFUNDED
  CANCELLED

  @@map("invoice_status")
}

enum PlanType {
  GENERAL
  PERSONAL_TRAINING

  @@map("plan_type")
}

enum TrainingMode {
  GROUP_CLASS
  PERSONAL_TRAINING
  HYBRID
  CUSTOM

  @@map("training_mode")
}

enum PackageTier {
  TRIAL
  DROP_IN
  PLUS
  VIP

  @@map("package_tier")
}

enum InvoiceType {
  SUBSCRIPTION_NEW
  PT_ADDON
  DROP_IN

  @@map("invoice_type")
}

enum LockerStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE

  @@map("locker_status")
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("cancellation_request_status")
}

enum CancellationTargetType {
  PERSONAL_TRAINING
  GROUP_CLASS

  @@map("cancellation_target_type")
}

enum ScheduleStatus {
  OPEN
  FULL               // Đủ chỗ: trigger DB suy ra từ current_enrolled/capacity khi cập nhật sĩ số
  CANCELLED_BY_COACH // HLV hủy khẩn cấp: ngừng nhận booking mới, giải phóng GiST exclusion khi cần
  COMPLETED          // Lớp đã diễn ra xong

  @@map("schedule_status")
}

// -------------------------------------------------------------
// MODELS (29 Models - Aligned 100% with SQL_v5.md & database.md)
// -------------------------------------------------------------

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique(map: "uq_users_email") @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(150)
  phone        String   @unique(map: "uq_users_phone") @db.VarChar(20)
  role         UserRole @default(MEMBER)
  avatarUrl    String?  @map("avatar_url") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Self-relation: Phân cấp người tạo tài khoản
  createdBy    User?  @relation("UserCreator", fields: [createdById], references: [id], onDelete: SetNull, map: "fk_users_created_by")
  createdUsers User[] @relation("UserCreator")

  // Relations
  memberProfile            MemberProfile?
  coachProfile             CoachProfile?
  coachRates               CoachRate[]
  coachAvailabilities      CoachAvailability[]
  subscriptions            UserSubscription[]      @relation("UserSubscriptions")
  assignedVipSubs          UserSubscription[]      @relation("AssignedCoachSubs")
  issuedInvoices           Invoice[]               @relation("InvoiceIssuer")
  coachedSchedules         Schedule[]              @relation("CoachSchedules")
  bookings                 Booking[]               @relation("MemberBookings")
  attendances              Attendance[]            @relation("MemberAttendances")
  verifiedAttendances      Attendance[]            @relation("VerifiedByStaff")
  staffShifts              StaffShift[]            @relation("StaffShifts")
  assignedStaffShifts      StaffShift[]            @relation("AssignedShifts")
  memberWorkoutPlans       WorkoutPlan[]           @relation("MemberWorkoutPlans")
  coachWorkoutPlans        WorkoutPlan[]           @relation("CoachWorkoutPlans")
  memberInbodyLogs         MemberInbodyLog[]       @relation("MemberInbodyLogs")
  measuredInbodyLogs       MemberInbodyLog[]       @relation("MeasuredByStaff")
  lockerAssignments        LockerAssignment[]      @relation("MemberLockerAssignments")
  assignedLockers          LockerAssignment[]      @relation("StaffLockerAssignments")
  coachCancellationRequests CancellationRequest[]  @relation("CoachCancellationRequests")
  reviewedCancellationRequests CancellationRequest[] @relation("ReviewedCancellationRequests")
  coachPenalties           CoachPenalty[]          @relation("CoachPenalties")
  auditLogs                AuditLog[]

  @@index([createdById], map: "idx_users_created_by_id")
  @@map("users")
}

model MemberProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique(map: "uq_member_profiles_user_id") @map("user_id") @db.Uuid
  heightCm       Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg       Decimal? @map("weight_kg") @db.Decimal(5, 2)
  bmi            Decimal? @map("bmi") @db.Decimal(4, 2)
  bodyFatPct     Decimal? @map("body_fat_pct") @db.Decimal(4, 2)
  fitnessGoals   String?  @map("fitness_goals") @db.Text
  medicalHistory String?  @map("medical_history") @db.Text
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_member_profiles_user")

  @@map("member_profiles")
}

model CoachProfile {
  id                             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                         String    @unique(map: "uq_coach_profiles_user_id") @map("user_id") @db.Uuid
  specialties                    String?   @db.Text
  bio                            String?   @db.Text
  certificateUrls                String[]  @default([]) @map("certificate_urls")
  yearsExperience                Int?      @default(0) @map("years_experience")
  // DSS — Hệ thống kỷ luật hủy khẩn cấp
  emergencyCancellationCount     Int       @default(0) @map("emergency_cancellation_count")
  monthlyEmergencyCancellations  Int       @default(0) @map("monthly_emergency_cancellations")
  lastCancellationResetDate      DateTime? @map("last_cancellation_reset_date") @db.Date
  updatedAt                      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_coach_profiles_user")
  coachSpecialties CoachSpecialty[]

  @@map("coach_profiles")
}

model CoachRate {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coachId        String    @map("coach_id") @db.Uuid
  ratePerSession Decimal   @map("rate_per_session") @db.Decimal(12, 2)
  effectiveFrom  DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo    DateTime? @map("effective_to") @db.Date
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  coach User @relation(fields: [coachId], references: [id], onDelete: Cascade, map: "fk_coach_rates_coach")

  @@index([coachId], map: "idx_coach_rates_coach_id")
  @@map("coach_rates")
}

model StaffShift {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  staffId      String   @map("staff_id") @db.Uuid
  shiftDate    DateTime @map("shift_date") @db.Date
  startTime    DateTime @map("start_time") @db.Timestamptz(6)
  endTime      DateTime @map("end_time") @db.Timestamptz(6)
  assignedById String?  @map("assigned_by_id") @db.Uuid
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  staff      User  @relation("StaffShifts", fields: [staffId], references: [id], onDelete: Cascade, map: "fk_staff_shifts_staff")
  assignedBy User? @relation("AssignedShifts", fields: [assignedById], references: [id], onDelete: SetNull, map: "fk_staff_shifts_assigned_by")

  @@index([staffId], map: "idx_staff_shifts_staff_id")
  @@index([shiftDate], map: "idx_staff_shifts_shift_date")
  @@map("staff_shifts")
}

model Discipline {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique(map: "uq_disciplines_code") @db.VarChar(50)
  name        String  @unique(map: "uq_disciplines_name") @db.VarChar(100)
  description String? @db.Text

  plans                  MembershipPlan[]
  classes                Class[]
  curriculumRequirements PlanCurriculumRequirement[]
  specialties            Specialty[]
  userSubscriptions      UserSubscription[]
  bookings               Booking[]

  @@map("disciplines")
}

model Specialty {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId String   @map("discipline_id") @db.Uuid
  code         String   @unique(map: "uq_specialties_code") @db.VarChar(50)
  name         String   @db.VarChar(150)
  description  String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  discipline       Discipline       @relation(fields: [disciplineId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_specialties_discipline")
  coachSpecialties CoachSpecialty[]

  @@index([disciplineId], map: "idx_specialties_discipline_id")
  @@map("specialties")
}

model CoachSpecialty {
  coachProfileId String   @map("coach_profile_id") @db.Uuid
  specialtyId    String   @map("specialty_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  coachProfile CoachProfile @relation(fields: [coachProfileId], references: [id], onDelete: Cascade, map: "fk_coach_spec_profile")
  specialty    Specialty    @relation(fields: [specialtyId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_coach_spec_specialty")

  @@id([coachProfileId, specialtyId])
  @@index([specialtyId], map: "idx_coach_specialties_spec_id")
  @@map("coach_specialties")
}

model MembershipPlan {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId      String?      @map("discipline_id") @db.Uuid
  name              String       @db.VarChar(100)
  description       String?      @db.Text
  price             Decimal      @db.Decimal(12, 2)
  durationDays      Int          @map("duration_days")
  sessionQuota      Int?         @map("session_quota")
  planType          PlanType     @default(GENERAL) @map("plan_type")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  packageTier       PackageTier  @default(PLUS) @map("package_tier")
  trainingMode      TrainingMode @default(GROUP_CLASS) @map("training_mode")
  groupSessionQuota Int?         @default(0) @map("group_session_quota")
  ptSessionQuota    Int?         @default(0) @map("pt_session_quota")
  unlimitedGymEntry Boolean?     @default(false) @map("unlimited_gym_entry")

  discipline             Discipline?                 @relation(fields: [disciplineId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_plans_discipline")
  subscriptions          UserSubscription[]
  curriculumRequirements PlanCurriculumRequirement[]

  @@map("membership_plans")
}

model PlanCurriculumRequirement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId          String   @map("plan_id") @db.Uuid
  disciplineId    String   @map("discipline_id") @db.Uuid
  sessionsPerWeek Int      @map("sessions_per_week")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plan       MembershipPlan @relation(fields: [planId], references: [id], onDelete: Cascade, map: "fk_curriculum_plan")
  discipline Discipline     @relation(fields: [disciplineId], references: [id], onDelete: Restrict, map: "fk_curriculum_discipline")

  @@unique([planId, disciplineId], map: "uq_curriculum_plan_discipline")
  @@index([planId], map: "idx_curriculum_plan_id")
  @@map("plan_curriculum_requirements")
}

model UserSubscription {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  planId                String             @map("plan_id") @db.Uuid
  disciplineId          String?            @map("discipline_id") @db.Uuid
  packageTier           PackageTier        @default(PLUS) @map("package_tier")
  assignedCoachId       String?            @map("assigned_coach_id") @db.Uuid
  startDate             DateTime           @map("start_date") @db.Date
  endDate               DateTime           @map("end_date") @db.Date
  remainingSessions     Int?               @map("remaining_sessions")
  remainingGroupSessions Int?              @default(0) @map("remaining_group_sessions")
  remainingPtSessions   Int?               @default(0) @map("remaining_pt_sessions")
  hasUnlimitedGymAccess Boolean?           @default(false) @map("has_unlimited_gym_access")
  status                SubscriptionStatus @default(ACTIVE)
  frozenAt              DateTime?          @map("frozen_at") @db.Timestamptz(6)
  createdAt             DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation("UserSubscriptions", fields: [userId], references: [id], onDelete: Restrict, map: "fk_user_subscriptions_user")
  plan          MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict, map: "fk_user_subscriptions_plan")
  discipline    Discipline?    @relation(fields: [disciplineId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_user_subscriptions_discipline")
  assignedCoach User?          @relation("AssignedCoachSubs", fields: [assignedCoachId], references: [id], onDelete: SetNull, map: "fk_user_subscriptions_coach")
  invoices      Invoice[]
  bookings      Booking[]

  @@index([userId], map: "idx_user_subscriptions_user_id")
  @@index([planId], map: "idx_user_subscriptions_plan_id")
  @@index([assignedCoachId], map: "idx_user_subscriptions_coach_id")
  @@map("user_subscriptions")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceCode    String        @unique(map: "uq_invoices_invoice_code") @map("invoice_code") @db.VarChar(50)
  subscriptionId String        @map("subscription_id") @db.Uuid
  issuerId       String        @map("issuer_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  baseAmount     Decimal?      @default(0) @map("base_amount") @db.Decimal(12, 2)
  ptAmount       Decimal?      @default(0) @map("pt_amount") @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  status         InvoiceStatus @default(PAID)
  type           InvoiceType   @default(SUBSCRIPTION_NEW)
  transactionRef String?       @map("transaction_ref") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, map: "fk_invoices_subscription")
  issuer       User             @relation("InvoiceIssuer", fields: [issuerId], references: [id], onDelete: Restrict, map: "fk_invoices_issuer")

  @@index([subscriptionId], map: "idx_invoices_subscription_id")
  @@index([issuerId], map: "idx_invoices_issuer_id")
  @@index([createdAt], map: "idx_invoices_created_at")
  @@map("invoices")
}

model Room {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String  @db.VarChar(100)
  capacity     Int
  locationNote String? @map("location_note") @db.Text
  isActive     Boolean @default(true) @map("is_active")

  schedules Schedule[]
  equipment Equipment[]

  @@map("rooms")
}

model Equipment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roomId        String   @map("room_id") @db.Uuid
  name          String   @db.VarChar(150)
  equipmentType String   @map("equipment_type") @db.VarChar(50)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  room         Room                   @relation(fields: [roomId], references: [id], onDelete: Restrict, map: "fk_equipment_room")
  reservations EquipmentReservation[]

  @@index([roomId], map: "idx_equipment_room_id")
  @@map("equipment")
}

model Class {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId String  @map("discipline_id") @db.Uuid
  name         String  @db.VarChar(150)
  description  String? @db.Text

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict, map: "fk_classes_discipline")
  schedules  Schedule[]

  @@index([disciplineId], map: "idx_classes_discipline_id")
  @@map("classes")
}

model Schedule {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId         String         @map("class_id") @db.Uuid
  roomId          String         @map("room_id") @db.Uuid
  coachId         String         @map("coach_id") @db.Uuid
  startTime       DateTime       @map("start_time") @db.Timestamptz(6)
  endTime         DateTime       @map("end_time") @db.Timestamptz(6)
  capacity        Int
  currentEnrolled Int            @default(0) @map("current_enrolled")
  status          ScheduleStatus @default(OPEN)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  class                Class                 @relation(fields: [classId], references: [id], onDelete: Cascade, map: "fk_schedules_class")
  room                 Room                  @relation(fields: [roomId], references: [id], onDelete: Restrict, map: "fk_schedules_room")
  coach                User                  @relation("CoachSchedules", fields: [coachId], references: [id], onDelete: Restrict, map: "fk_schedules_coach")
  bookings             Booking[]
  cancellationRequests CancellationRequest[]

  @@index([classId], map: "idx_schedules_class_id")
  @@index([roomId], map: "idx_schedules_room_id")
  @@index([coachId], map: "idx_schedules_coach_id")
  @@index([startTime], map: "idx_schedules_start_time")
  @@map("schedules")
}

model CoachAvailability {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  coachId               String   @map("coach_id") @db.Uuid
  startTime             DateTime @map("start_time") @db.Timestamptz(6)
  endTime               DateTime @map("end_time") @db.Timestamptz(6)
  isBooked              Boolean  @default(false) @map("is_booked")
  // Đặt true khi HLV hủy khẩn cấp → slot không thể bị đặt lại dù is_booked = false
  isEmergencyCancelled  Boolean  @default(false) @map("is_emergency_cancelled")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  coach    User      @relation(fields: [coachId], references: [id], onDelete: Cascade, map: "fk_coach_availability_coach")
  bookings Booking[]

  @@index([coachId], map: "idx_coach_availability_coach_id")
  @@index([startTime], map: "idx_coach_availability_start_time")
  @@map("coach_availability")
}

model Booking {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscriptionId          String        @map("subscription_id") @db.Uuid
  bookingType             BookingType   @default(GROUP_CLASS) @map("booking_type")
  disciplineId            String?       @map("discipline_id") @db.Uuid
  scheduleId              String?       @map("schedule_id") @db.Uuid
  coachAvailabilityId     String?       @map("coach_availability_id") @db.Uuid
  memberId                String        @map("member_id") @db.Uuid
  status                  BookingStatus @default(CONFIRMED)
  bookedAt                DateTime      @default(now()) @map("booked_at") @db.Timestamptz(6)
  cancelledAt             DateTime?     @map("cancelled_at") @db.Timestamptz(6)
  isLateCancellation      Boolean?      @default(false) @map("is_late_cancellation")
  cancellationReason      String?       @map("cancellation_reason") @db.Text
  cancelledBy             String?       @default("MEMBER") @map("cancelled_by") @db.VarChar(20)
  isEmergencyCancellation Boolean       @default(false) @map("is_emergency_cancellation")

  subscription         UserSubscription      @relation(fields: [subscriptionId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_bookings_subscription")
  discipline           Discipline?           @relation(fields: [disciplineId], references: [id], onUpdate: Cascade, onDelete: Restrict, map: "fk_bookings_discipline")
  schedule             Schedule?             @relation(fields: [scheduleId], references: [id], onDelete: Cascade, map: "fk_bookings_schedule")
  coachAvailability    CoachAvailability?    @relation(fields: [coachAvailabilityId], references: [id], onDelete: Cascade, map: "fk_bookings_coach_availability")
  member               User                  @relation("MemberBookings", fields: [memberId], references: [id], onDelete: Cascade, map: "fk_bookings_member")
  attendance           Attendance?
  equipmentReservation EquipmentReservation?
  cancellationRequests CancellationRequest[]
  coachPenalties       CoachPenalty[]

  @@index([subscriptionId], map: "idx_bookings_subscription_id")
  @@index([disciplineId], map: "idx_bookings_discipline_id")
  @@index([scheduleId], map: "idx_bookings_schedule_id")
  @@index([coachAvailabilityId], map: "idx_bookings_coach_availability_id")
  @@index([memberId], map: "idx_bookings_member_id")
  @@map("bookings")
}

model EquipmentReservation {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipmentId String   @map("equipment_id") @db.Uuid
  bookingId   String   @unique(map: "uq_equipment_reservation_booking") @map("booking_id") @db.Uuid
  startTime   DateTime @map("start_time") @db.Timestamptz(6)
  endTime     DateTime @map("end_time") @db.Timestamptz(6)
  reservedAt  DateTime @default(now()) @map("reserved_at") @db.Timestamptz(6)

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade, map: "fk_equipment_reservations_equipment")
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade, map: "fk_equipment_reservations_booking")

  @@index([equipmentId], map: "idx_equipment_reservations_equipment_id")
  @@index([startTime, endTime], map: "idx_equipment_reservations_time")
  @@map("equipment_reservations")
}

model Attendance {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String?          @unique(map: "uq_attendances_booking_id") @map("booking_id") @db.Uuid
  memberId     String           @map("member_id") @db.Uuid
  verifiedById String?          @map("verified_by_id") @db.Uuid
  checkInTime  DateTime         @default(now()) @map("check_in_time") @db.Timestamptz(6)
  status       AttendanceStatus @default(PRESENT)
  checkinType  String           @default("CLASS_SESSION") @map("checkin_type") @db.VarChar(20)
  towelIssued  Boolean?         @default(false) @map("towel_issued")
  notes        String?          @db.Text

  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull, map: "fk_attendances_booking")
  member     User     @relation("MemberAttendances", fields: [memberId], references: [id], onDelete: Cascade, map: "fk_attendances_member")
  verifiedBy User?    @relation("VerifiedByStaff", fields: [verifiedById], references: [id], onDelete: SetNull, map: "fk_attendances_verifier")


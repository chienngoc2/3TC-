  coach     User              @relation("CoachWorkoutPlans", fields: [coachId], references: [id], onDelete: Restrict, map: "fk_workout_plans_coach")
  exercises WorkoutExercise[]

  @@index([memberId], map: "idx_workout_plans_member_id")
  @@index([coachId], map: "idx_workout_plans_coach_id")

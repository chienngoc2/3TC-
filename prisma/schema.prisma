datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  MANAGER
  COACH
  RECEPTIONIST
  MEMBER

  @@map("user_role")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  FROZEN

  @@map("subscription_status")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ATTENDED

  @@map("booking_status")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE

  @@map("attendance_status")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD

  @@map("payment_method")
}

enum InvoiceStatus {
  PAID
  PENDING
  REFUNDED
  CANCELLED

  @@map("invoice_status")
}

// -------------------------------------------------------------
// MODELS
// -------------------------------------------------------------

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique(map: "uq_users_email") @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(150)
  phone        String   @unique(map: "uq_users_phone") @db.VarChar(20)
  role         UserRole @default(MEMBER)
  avatarUrl    String?  @map("avatar_url") @db.Text
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  // Relations
  memberProfile       MemberProfile?
  coachProfile        CoachProfile?
  subscriptions       UserSubscription[]
  issuedInvoices      Invoice[]            @relation("InvoiceIssuer")
  coachedSchedules    Schedule[]           @relation("CoachSchedules")
  bookings            Booking[]
  attendances         Attendance[]         @relation("MemberAttendances")
  verifiedAttendances Attendance[]         @relation("VerifiedByStaff")
  memberWorkoutPlans  WorkoutPlan[]        @relation("MemberWorkoutPlans")
  coachWorkoutPlans   WorkoutPlan[]        @relation("CoachWorkoutPlans")
  auditLogs           AuditLog[]

  @@map("users")
}

model MemberProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @unique(map: "uq_member_profiles_user_id") @map("user_id") @db.Uuid
  heightCm       Decimal? @map("height_cm") @db.Decimal(5, 2)
  weightKg       Decimal? @map("weight_kg") @db.Decimal(5, 2)
  bmi            Decimal? @map("bmi") @db.Decimal(4, 2)
  bodyFatPct     Decimal? @map("body_fat_pct") @db.Decimal(4, 2)
  fitnessGoals   String?  @map("fitness_goals") @db.Text
  medicalHistory String?  @map("medical_history") @db.Text
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_member_profiles_user")

  @@map("member_profiles")
}

model CoachProfile {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @unique(map: "uq_coach_profiles_user_id") @map("user_id") @db.Uuid
  specialties     String?  @db.Text
  bio             String?  @db.Text
  certificateUrls String[] @default([]) @map("certificate_urls")
  yearsExperience Int?     @default(0) @map("years_experience")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, map: "fk_coach_profiles_user")

  @@map("coach_profiles")
}

model MembershipPlan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  description  String?  @db.Text
  price        Decimal  @db.Decimal(12, 2)
  durationDays Int      @map("duration_days")
  sessionQuota Int?     @map("session_quota")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  subscriptions UserSubscription[]

  @@map("membership_plans")
}

model UserSubscription {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String             @map("user_id") @db.Uuid
  planId            String             @map("plan_id") @db.Uuid
  startDate         DateTime           @map("start_date") @db.Date
  endDate           DateTime           @map("end_date") @db.Date
  remainingSessions Int?               @map("remaining_sessions")
  status            SubscriptionStatus @default(ACTIVE)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict, map: "fk_user_subscriptions_user")
  plan     MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict, map: "fk_user_subscriptions_plan")
  invoices Invoice[]

  @@index([userId], map: "idx_user_subscriptions_user_id")
  @@index([planId], map: "idx_user_subscriptions_plan_id")
  @@map("user_subscriptions")
}

model Invoice {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceCode    String        @unique(map: "uq_invoices_invoice_code") @map("invoice_code") @db.VarChar(50)
  subscriptionId String        @map("subscription_id") @db.Uuid
  issuerId       String        @map("issuer_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  paymentMethod  PaymentMethod @map("payment_method")
  status         InvoiceStatus @default(PAID)
  transactionRef String?       @map("transaction_ref") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription UserSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict, map: "fk_invoices_subscription")
  issuer       User             @relation("InvoiceIssuer", fields: [issuerId], references: [id], onDelete: Restrict, map: "fk_invoices_issuer")

  @@index([subscriptionId], map: "idx_invoices_subscription_id")
  @@index([issuerId], map: "idx_invoices_issuer_id")
  @@index([createdAt], map: "idx_invoices_created_at")
  @@map("invoices")
}

model Discipline {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String  @unique(map: "uq_disciplines_name") @db.VarChar(100)
  description String? @db.Text

  classes Class[]

  @@map("disciplines")
}

model Room {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(100)
  capacity     Int
  locationNote String?  @map("location_note") @db.Text
  isActive     Boolean  @default(true) @map("is_active")

  schedules Schedule[]

  @@map("rooms")
}

model Class {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  disciplineId String  @map("discipline_id") @db.Uuid
  name         String  @db.VarChar(150)
  description  String? @db.Text

  discipline Discipline @relation(fields: [disciplineId], references: [id], onDelete: Restrict, map: "fk_classes_discipline")
  schedules  Schedule[]

  @@index([disciplineId], map: "idx_classes_discipline_id")
  @@map("classes")
}

model Schedule {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  classId         String   @map("class_id") @db.Uuid
  roomId          String   @map("room_id") @db.Uuid
  coachId         String   @map("coach_id") @db.Uuid
  startTime       DateTime @map("start_time") @db.Timestamptz(6)
  endTime         DateTime @map("end_time") @db.Timestamptz(6)
  capacity        Int
  currentEnrolled Int      @default(0) @map("current_enrolled")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  class    Class     @relation(fields: [classId], references: [id], onDelete: Cascade, map: "fk_schedules_class")
  room     Room      @relation(fields: [roomId], references: [id], onDelete: Restrict, map: "fk_schedules_room")
  coach    User      @relation("CoachSchedules", fields: [coachId], references: [id], onDelete: Restrict, map: "fk_schedules_coach")
  bookings Booking[]

  @@index([classId], map: "idx_schedules_class_id")
  @@index([roomId], map: "idx_schedules_room_id")
  @@index([coachId], map: "idx_schedules_coach_id")
  @@index([startTime], map: "idx_schedules_start_time")
  @@map("schedules")
}

model Booking {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scheduleId String        @map("schedule_id") @db.Uuid
  memberId   String        @map("member_id") @db.Uuid
  status     BookingStatus @default(CONFIRMED)
  bookedAt   DateTime      @default(now()) @map("booked_at") @db.Timestamptz(6)

  schedule   Schedule    @relation(fields: [scheduleId], references: [id], onDelete: Cascade, map: "fk_bookings_schedule")
  member     User        @relation(fields: [memberId], references: [id], onDelete: Cascade, map: "fk_bookings_member")
  attendance Attendance?

  @@index([scheduleId], map: "idx_bookings_schedule_id")
  @@index([memberId], map: "idx_bookings_member_id")
  @@map("bookings")
}

model Attendance {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bookingId    String?          @unique(map: "uq_attendances_booking_id") @map("booking_id") @db.Uuid
  memberId     String           @map("member_id") @db.Uuid
  verifiedById String?          @map("verified_by_id") @db.Uuid
  checkInTime  DateTime         @default(now()) @map("check_in_time") @db.Timestamptz(6)
  status       AttendanceStatus @default(PRESENT)
  checkinType  String           @default("CLASS_SESSION") @map("checkin_type") @db.VarChar(20)
  notes        String?          @db.Text

  booking    Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull, map: "fk_attendances_booking")
  member     User     @relation("MemberAttendances", fields: [memberId], references: [id], onDelete: Cascade, map: "fk_attendances_member")
  verifiedBy User?    @relation("VerifiedByStaff", fields: [verifiedById], references: [id], onDelete: SetNull, map: "fk_attendances_verifier")

  @@index([memberId], map: "idx_attendances_member_id")
  @@index([verifiedById], map: "idx_attendances_verified_by_id")
  @@index([checkInTime], map: "idx_attendances_check_in_time")
  @@map("attendances")
}

model WorkoutPlan {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @map("member_id") @db.Uuid
  coachId   String   @map("coach_id") @db.Uuid
  title     String   @db.VarChar(150)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  member    User              @relation("MemberWorkoutPlans", fields: [memberId], references: [id], onDelete: Cascade, map: "fk_workout_plans_member")
  coach     User              @relation("CoachWorkoutPlans", fields: [coachId], references: [id], onDelete: Restrict, map: "fk_workout_plans_coach")
  exercises WorkoutExercise[]

  @@index([memberId], map: "idx_workout_plans_member_id")
  @@index([coachId], map: "idx_workout_plans_coach_id")
  @@map("workout_plans")
}

model ExerciseKnowledge {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title        String  @db.VarChar(150)
  category     String  @db.VarChar(50)
  instructions String  @db.Text

  exercises WorkoutExercise[]

  @@map("exercise_knowledge")
}

model WorkoutExercise {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workoutPlanId String   @map("workout_plan_id") @db.Uuid
  exerciseId    String   @map("exercise_id") @db.Uuid
  sets          Int?
  reps          Int?
  weightKg      Decimal? @map("weight_kg") @db.Decimal(5, 2)
  restSeconds   Int?     @map("rest_seconds")
  coachFeedback String?  @map("coach_feedback") @db.Text
  orderIndex    Int      @default(0) @map("order_index")

  workoutPlan WorkoutPlan       @relation(fields: [workoutPlanId], references: [id], onDelete: Cascade, map: "fk_workout_exercises_plan")
  exercise    ExerciseKnowledge @relation(fields: [exerciseId], references: [id], onDelete: Restrict, map: "fk_workout_exercises_exercise")

  @@index([workoutPlanId], map: "idx_workout_exercises_plan_id")
  @@index([exerciseId], map: "idx_workout_exercises_exercise_id")
  @@map("workout_exercises")
}

model AuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  targetEntity String   @map("target_entity") @db.VarChar(100)
  targetId     String?  @map("target_id") @db.Uuid
  beforeState  Json?    @map("before_state")
  afterState   Json?    @map("after_state")
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull, map: "fk_audit_logs_user")

  @@index([userId], map: "idx_audit_logs_user_id")
  @@index([targetEntity, targetId], map: "idx_audit_logs_target_entity_id")
  @@index([createdAt], map: "idx_audit_logs_created_at")
  @@map("audit_logs")
}
